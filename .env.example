# DATABASE_URL: Neon (Postgres) connection string. Server-side only — read by
# server/handlers.js (via the @neondatabase/serverless HTTP driver) and by
# server/migrate.js. Never exposed to the browser.
#
#   - Locally (npm run dev / npm run db:migrate): put it in a local .env file.
#   - In production: set it as an environment variable in the Cloudflare Pages
#     dashboard (Settings -> Environment variables). The Functions (functions/api)
#     read it from context.env.DATABASE_URL.
#
# Example (replace with your actual Neon connection string):
DATABASE_URL="postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/dbname?sslmode=require"
